# =========================
# Data artifacts (AI/ML)
# =========================
# 赛题原始 CSV 与可再生全量索引（保留占位 .gitkeep）
data/raw/**
!data/raw/.gitkeep

# 预处理 / 切分产物：含 processed_smoke、processed_horizon_*、splits_sid* 等变体
data/processed*/
data/splits*/
data/artifacts/

# preprocess 并行写盘时的半成品（clean.sh 亦会删除）
data/**/*.tmp
data/**/*.normtmp
data/**/*.tmp.npy
data/**/*.normtmp.npy

# data/index_stubs/ 下演示索引 intentionally tracked（小 CSV，未列入 ignore）
!data/README.md
!data/**/.gitkeep

# =========================
# Training / inference outputs
# =========================
runs/**
outputs/*
!outputs/README.md
!outputs/figures/
!outputs/tables/
!outputs/reports/
!outputs/notebooks/
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/notebooks/*
!outputs/notebooks/.gitkeep
checkpoints/**
logs/**
mlruns/**
wandb/**
*.log

!runs/.gitkeep
!checkpoints/.gitkeep

