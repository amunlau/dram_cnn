flowchart TB
  subgraph IN["输入"]
    X["x<br/>[N, C, H, W]<br/>通道 C 不变"]
  end

  subgraph MAIN["主路径 F(x)"]
    direction TB
    C1["ConvBNReLU #1<br/>Conv2d 3×3 · C→C<br/>BatchNorm · ReLU"]
    C2["Conv2d 3×3 · C→C<br/>padding=1 · bias=False"]
    BN2["BatchNorm2d(C)"]
    D["Dropout2d(p)<br/>仅 Stage 末块启用<br/>默认 p=0.25"]
    C1 --> C2 --> BN2 --> D
  end

  subgraph SHORT["捷径"]
    ID["恒等映射 x"]
  end

  ADD["逐元素相加<br/>F(x) + x"]
  RELU["ReLU"]
  OUT["输出<br/>[N, C, H, W]"]

  X --> C1
  X --> ID
  D --> ADD
  ID --> ADD
  ADD --> RELU --> OUT
