flowchart TB
  %% ===== 图1：本发明方法总体流程 =====
  %% 布局：自上而下四阶段；阶段二显式分为「特征支路 / 标签支路」

  subgraph IN["原始输入"]
    direction LR
    IN_LOG["机器检错日志<br/>sid · error_time · row/col/bankid"]
    IN_TIX["故障工单<br/>sid · failed_time · failure_type"]
    IN_INV["硬件台账<br/>DRAM 型号 · DIMM · 厂商"]
  end

  IN_LOG --- IN_TIX
  IN_TIX --- IN_INV

  subgraph P1["阶段一 · 样本索引构建"]
    direction TB
    P1_1["统一相对时间轴<br/>统计各 sid 可观测区间 [t_min, t_max]"]
    P1_2["三类锚点程序化生成"]
    P1_2A["正样本区 [ft−H, ft]<br/>步长 Δp 密集采样"]
    P1_2B["近故障困难负样本 [ft−T_pre, ft−H)<br/>步长 Δn"]
    P1_2C["全局负样本 · 目标正负比控制<br/>单 sid 负样本上限"]
    P1_3[("索引表<br/>(sid, predict_ts)")]
    P1_1 --> P1_2
    P1_2 --> P1_2A & P1_2B & P1_2C
    P1_2A & P1_2B & P1_2C --> P1_3
  end

  subgraph P2["阶段二 · 空间热图构建、打标与数据集准备"]
    direction TB

    P2_IDX["逐条读取索引锚点 predict_ts"]

    subgraph P2_FEAT["特征支路（半开因果窗）"]
      direction TB
      P2_F1["特征窗 [predict_ts−W, predict_ts)<br/>仅取锚点之前 CE 事件"]
      P2_F2["row/col 分箱 · 按 Bank 通道累加计数"]
      P2_F3["log1p 变换"]
      P2_F4["台账 one-hot 广播为常数通道"]
      P2_F5[("多通道热图 X<br/>[C, H, W]")]
      P2_F1 --> P2_F2 --> P2_F3 --> P2_F4 --> P2_F5
    end

    subgraph P2_LAB["标签支路（与特征独立）"]
      direction TB
      P2_L1["标签窗 [predict_ts, predict_ts+H]（闭）"]
      P2_L2["工单 failed_ts 时间对齐"]
      P2_L3[("二分类标签 y")]
      P2_L1 --> P2_L2 --> P2_L3
    end

    P2_POST["时间切分 train/val/test<br/>训练集拟合稳健归一化并应用"]
    P2_OUT[("训练/验证/测试样本集<br/>(X, y)")]

    P2_IDX --> P2_F1
    P2_IDX --> P2_L1
    P2_F5 --> P2_POST
    P2_L3 --> P2_POST
    P2_POST --> P2_OUT
  end

  subgraph P3["阶段三 · GridCNN 训练与阈值校准"]
    direction TB
    P3_1["GridCNN 前向 · 输出二分类得分"]
    P3_2["不平衡处理<br/>平方根类别加权损失 + 正样本过采样"]
    P3_3["验证集网格搜索 F1 最优阈值 τ*"]
    P3_4["早停 · 保存检查点"]
    P3_OUT[("模型权重 + τ*")]
    P3_1 --> P3_2 --> P3_3 --> P3_4 --> P3_OUT
  end

  subgraph P4["阶段四 · 推理与部署判定"]
    direction TB
    P4_1["加载模型权重与 τ*"]
    P4_2["softmax 得正类概率 p"]
    P4_3["p ≥ τ* → 预测故障<br/>p < τ* → 预测正常"]
    P4_OUT[("故障预测结果")]
    P4_1 --> P4_2 --> P4_3 --> P4_OUT
  end

  %% ===== 阶段间主数据流 =====
  IN_LOG --> P1_1
  IN_TIX --> P1_1

  P1_3 ==> P2_IDX

  IN_LOG -.->|CE 事件| P2_F2
  IN_INV -.->|sid 查表| P2_F4
  IN_TIX -.->|打标规则| P2_L2

  P2_OUT ==> P3_1
  P3_OUT ==> P4_1

  %% 样式：关键产物加粗边框感（部分渲染器支持）
  classDef artifact fill:#f0f4ff,stroke:#334,stroke-width:2px
  class P1_3,P2_F5,P2_L3,P2_OUT,P3_OUT,P4_OUT artifact
