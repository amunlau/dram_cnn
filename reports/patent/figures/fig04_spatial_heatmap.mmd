flowchart TB
  EV["特征窗内 CE 事件<br/>(row, col, bankid)"]
  EV --> BIN["row/col 分箱映射<br/>→ H×W 网格"]
  BIN --> ACC["按 Bank 通道累加计数"]
  ACC --> LOG["逐元素 log1p"]
  LOG --> BANK["16 路 Bank 密度平面"]

  INV["硬件台账 one-hot"] --> BROAD["广播为 H×W 常数平面"]
  BROAD --> TAB["15 路台账通道"]

  BANK --> CAT["通道维拼接"]
  TAB --> CAT
  CAT --> X["多通道空间热图<br/>[C, H, W]"]
